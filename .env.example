# Address that receives every payment. Public, receiving only.
# The seller never signs anything, so no private key is involved at any point.
X402_PAY_TO=0x712c78928080Adb009E31315c0c3c7473dA9648a

# base-sepolia (free testnet) or base (real money)
X402_NETWORK=base-sepolia

# Price per call in USD, settled in USDC
X402_PRICE_USD=0.001

# Public origin the service is reachable at. Must be the real one in production:
# it becomes the resource URL that agents discover and call.
PUBLIC_URL=http://localhost:8402

# Optional. Defaults to a keyless facilitator for the chosen network.
#   testnet  https://x402.org/facilitator
#   mainnet  https://facilitator.xpay.sh
# Coinbase CDP indexes into the largest Bazaar but needs a key:
#   https://api.cdp.coinbase.com/platform/v2/x402
# X402_FACILITATOR_URL=
# X402_FACILITATOR_TOKEN=

# Coinbase CDP. Required only when X402_FACILITATOR_URL points at cdp.coinbase.com,
# which is what gets the resource into the 15,000-entry Bazaar. Free to create at
# portal.cdp.coinbase.com. The secret is an Ed25519 key: a fresh JWT is signed per
# request, so the secret itself never leaves the server.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

PORT=8402
