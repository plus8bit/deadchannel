{
  "name": "deadchannel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Risk oracle for x402 endpoints \u2014 tells agents which paid endpoints are alive, honestly priced, and safe to call. Zero runtime dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "node src/cli.ts",
    "serve": "node src/server/app.ts",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:fn": "esbuild src/server/vercel-entry.ts --bundle --platform=node --target=node22 --format=esm --outfile=api/index.mjs --log-level=warning",
    "vercel-build": "npm run build:fn",
    "validate": "node scripts/validate-listing.mjs",
    "demo": "node scripts/demo.mjs",
    "stats": "node scripts/stats.mjs",
    "build:hosaka": "esbuild src/hosaka/server/vercel-entry.ts --bundle --platform=node --target=node22 --format=esm --outfile=hosaka/api/index.mjs --log-level=warning",
    "hosaka:validate": "RESOURCE_URL=https://hosaka-agents.vercel.app/lookup node scripts/validate-listing.mjs",
    "hosaka:buy": "TARGET_URL=https://hosaka-agents.vercel.app/lookup node scripts/first-payment.mjs",
    "hosaka:stats": "RESOURCE_URL=https://hosaka-agents.vercel.app/lookup node scripts/stats.mjs",
    "deploy": "scripts/deploy.sh",
    "mcp": "node src/hosaka/mcp/server.ts",
    "build:mcp": "esbuild src/hosaka/mcp/server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=packages/hosaka-mcp/src/server.mjs --log-level=warning"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "viem": "^2.55.19"
  }
}
